# udev rules for KWorld ISDB-T UB320-i
# Allows non-root access after firmware is loaded

# Bootloader mode (before firmware load - needs root)
SUBSYSTEM=="usb", ATTR{idVendor}=="1738", ATTR{idProduct}=="5211", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Operational mode (after firmware load)
SUBSYSTEM=="usb", ATTR{idVendor}=="1b80", ATTR{idProduct}=="b320", MODE="0660", GROUP="plugdev", TAG+="uaccess"
